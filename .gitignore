doc/api/

# dotenv environment variables file
.env*

.flutter-plugins
.flutter-plugins-dependencies

# Android imzalama anahtarları repoya eklenmez
*.jks
*.keystore
key.properties

# Flutter
**/ios/Flutter/.last_build_id
/coverage/
.widget_preview/

# IDE (kişisel ayarlar, sürekli değişir)
.idea/
*.iml

# Firebase (Hosting önbelleği, Emulator logları)
.firebase/
*.log

# Kural testleri (npm)
node_modules/

# Android derleme çıktıları
/android/app/debug
/android/app/profile
/android/app/release

# Sembol ve karartma (obfuscation) çıktıları
app.*.symbols
app.*.map.json

